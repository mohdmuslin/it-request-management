APP_NAME="IT Request Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Identity provider (FR-001)
#
# `local` holds accounts in the users table — the default, and what the POC runs on.
# `entra` signs in through Microsoft Entra ID.
#
# Switching to `entra` without the four values below does NOT break sign-in: the
# application falls back to local accounts and shows a warning naming the missing
# setting. That is deliberate — a pending app registration must not lock everybody out
# — but the warning is there so nobody concludes SSO is live when it is not.
#
# The redirect URI must be registered in the app registration EXACTLY as written
# here. A mismatch fails on Microsoft's page and never reaches this application's log.
# See docs/deployment.md §8.
# ---------------------------------------------------------------------------
ITREQUEST_IDENTITY_DRIVER=local
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_REDIRECT_URI="${APP_URL}/auth/callback"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# `smtp` with `tls` on 587 is the cPanel norm for this host. The port and scheme are
# listed by cPanel under Email Accounts → Connect Devices, and they are NOT always the
# defaults — some accounts are configured for SSL on 465, which is a different scheme.
MAIL_SCHEME=tls
MAIL_HOST=mail.mwstay.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Must be an address the mail server will actually send as. A mismatch between this and
# the authenticated account is the commonest cause of a message that is accepted and
# then silently dropped.
MAIL_FROM_ADDRESS="itrequest@mwstay.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Notification delivery — the Phase C gate.
#
# LEAVE THIS FALSE until one real message has been received in a real inbox.
#
# With it false, every notification is still RECORDED in the `notifications` table and
# written to the log, but nothing is delivered and rows stay `pending`. That is
# deliberate: marking an undelivered notification `sent` would make the log assert a
# delivery that never happened, and the first real send would then be invisible.
#
# Do not switch this on because the settings above look right. `MAIL_MAILER=log` looks
# configured too — it is a real mailer, the config saves, and nothing errors.
#
# Prove it first:  php artisan itrequest:test-mail you@mwstay.com
# ---------------------------------------------------------------------------
ITREQUEST_MAIL_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

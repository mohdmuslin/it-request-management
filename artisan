#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Repair the storage tree BEFORE the framework boots — see the comments in
// that file. This is what makes `itrequest:install` runnable on a host whose
// storage tree was excluded from the transfer, including the case where the
// exclusion itself is what removed it.
require __DIR__.'/bootstrap/ensure-storage.php';

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
